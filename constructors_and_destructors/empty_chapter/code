#include <iostream>

class Transaction {
public:
    Transaction(float amount, float rate);
    float processTransaction(float feePercent, float targetRate);

    float amount;
    float rate;
    float total;
};

// Constructor with initializer‐list
Transaction::Transaction(float amount, float rate)
    : amount(amount), rate(rate), total(amount * rate)
{
    // body left empty
}

float Transaction::processTransaction(float feePercent, float targetRate) {
    total -= total * (feePercent / 100.0f);
    total *= targetRate;
    return total;
}

int main() {
    Transaction t1(100, 1.2f);
    Transaction t2(50, 0.9f);

    std::cout << t1.processTransaction(5, 0.8f) << std::endl;   // 91.2
    std::cout << t2.processTransaction(10, 1.1f) << std::endl;  // 44.55

    return 0;
}